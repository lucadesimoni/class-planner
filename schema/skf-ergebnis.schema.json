{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lucadesimoni/stunden-klassen-fitter/schema/skf-ergebnis.schema.json",
  "title": "skf-ergebnis",
  "description": "Ergebnis einer Berechnung (Klassen, Zuteilung, Lehraufträge, Stundenplan, Meldungen). Erzeugt als ergebnis.json bei jeder Berechnung; Beschreibung in docs/datenformate.md.",
  "type": "object",
  "required": ["format", "version", "programm", "schule", "szenario", "vollstaendig", "kennzahlen", "zeitfenster",
               "klassen", "zuteilung", "lehrauftraege", "stundenplan", "meldungen"],
  "properties": {
    "format": {"const": "skf-ergebnis"},
    "version": {"const": 1, "description": "Version dieses Formats"},
    "programm": {"type": "string", "description": "Programmversion (Semantic Versioning)"},
    "profilversion": {"type": "string", "description": "Version des Kantonsprofils"},
    "erstellt": {"type": "string", "description": "Zeitpunkt (ISO 8601, lokale Zeit)"},
    "schule": {"type": "string"},
    "schuljahr": {"type": "string"},
    "szenario": {"type": "string"},
    "vollstaendig": {"type": "boolean", "description": "true = Klassen, Lehraufträge und Stundenplan berechnet"},
    "kennzahlen": {"type": "object", "additionalProperties": {"type": "string"}},
    "loesungsguete": {"type": "array", "items": {"type": "object", "properties": {
      "schritt": {"type": "string"}, "status": {"enum": ["beweisbar optimal", "gute Lösung"]},
      "mindestens": {"type": "number", "description": "garantierte Mindestgüte in % des Optimums"},
      "sekunden": {"type": "number"}}}},
    "zeitfenster": {"type": "array", "items": {"type": "object", "required": ["index", "tag", "halbtag", "lektion", "beginn"],
      "properties": {"index": {"type": "integer"}, "tag": {"type": "string"}, "halbtag": {"type": "string"},
                     "lektion": {"type": "integer", "minimum": 1}, "beginn": {"type": "string"}}}},
    "klassen": {"type": "array", "items": {"type": "object",
      "required": ["name", "schulhaus", "raum", "jahrgaenge", "lernende", "anzahl"],
      "properties": {"name": {"type": "string"}, "schulhaus": {"type": "string"}, "raum": {"type": "string"},
                     "klassentyp": {"type": "string"}, "jahrgaenge": {"type": "array", "items": {"type": "string"}},
                     "lernende": {"type": "array", "items": {"type": "string"}, "description": "IDs der Lernenden"},
                     "anzahl": {"type": "integer"}, "maedchen": {"type": "integer"}, "knaben": {"type": "integer"}}}},
    "zuteilung": {"type": "object", "description": "ID der Lernenden → Schulhaus, Klasse, geschätzter Schulweg",
      "additionalProperties": {"type": "object", "required": ["schulhaus", "klasse"],
        "properties": {"schulhaus": {"type": "string"}, "klasse": {"type": "string"},
                       "schulweg_m": {"type": "integer", "minimum": 0}}}},
    "lehrauftraege": {"type": "array", "items": {"type": "object", "required": ["lehrperson", "klasse", "fach", "lektionen"],
      "properties": {"lehrperson": {"type": "string"}, "klasse": {"type": "string"},
                     "klassen": {"type": "array", "items": {"type": "string"}}, "fach": {"type": "string"},
                     "lektionen": {"type": "integer", "minimum": 0}, "art": {"enum": ["unterricht", "foerder"]}}}},
    "stundenplan": {"type": "array", "items": {"type": "object",
      "required": ["zeitfenster", "tag", "beginn", "klasse", "fach", "lehrperson"],
      "properties": {"zeitfenster": {"type": "integer"}, "tag": {"type": "string"}, "beginn": {"type": "string"},
                     "klasse": {"type": "string"}, "klassen": {"type": "array", "items": {"type": "string"}},
                     "fach": {"type": "string"}, "lehrperson": {"type": "string"}, "raum": {"type": "string"},
                     "raum_schulhaus": {"type": "string"}, "schulhaus": {"type": "string"},
                     "art": {"enum": ["unterricht", "foerder"]}}}},
    "meldungen": {"type": "array", "items": {"type": "object", "required": ["schweregrad", "bereich", "text"],
      "properties": {"schweregrad": {"enum": ["Fehler", "Warnung", "Hinweis"]}, "bereich": {"type": "string"},
                     "text": {"type": "string"}, "bezug": {"type": "string"},
                     "zeitfenster": {"type": ["integer", "null"]}, "quelle": {"type": "string"}}}}
  }
}
